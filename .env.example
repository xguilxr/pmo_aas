# ==== Database ====
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pmoaas
REDIS_URL=redis://localhost:6379/0

# ==== Auth ====
JWT_SECRET=change_me_32_bytes_hex
JWT_REFRESH_SECRET=change_me_another_32_bytes_hex
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=2592000
BCRYPT_ROUNDS=12

# ==== App ====
PYTHON_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
# Lockout de login: intentos fallidos antes de bloquear + minutos de bloqueo.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ==== Storage (uploads + branding, US-066) ====
# STORAGE_BACKEND: local | s3  (s3 = object storage S3-compatible, R2 en prod)
STORAGE_BACKEND=local
STORAGE_PATH=/tmp/pmo-uploads
S3_BUCKET=
S3_ENDPOINT_URL=   # ej. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto     # "auto" para Cloudflare R2; región concreta para AWS/B2

# ==== Email (Resend, US-028) ====
# Sin RESEND_API_KEY el canal email queda deshabilitado (no rompe nada).
RESEND_API_KEY=
RESEND_FROM=       # ej. "PMO·aaS <no-reply@pmo-aas.com>"
APP_BASE_URL=https://app.pmo-aas.com

# ==== AI ====
# AI_MODE: disabled | platform | byo (default: platform)
AI_MODE=platform
# Groq (modo "platform"). En prod la key vive cifrada en platform_ai_settings.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fernet key para cifrar BYO api_keys + Groq platform key (32 bytes base64).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SECRETS_FERNET_KEY=
# Defaults env-only (BYO de tenants no usan estos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ==== Frontend (Next.js) ====
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_web_secret
