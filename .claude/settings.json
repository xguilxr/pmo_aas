{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)"
    ],
    "ask": [
      "Bash(alembic upgrade *)",
      "Bash(alembic downgrade *)",
      "Bash(gh issue close *)",
      "Bash(git commit --amend *)",
      "Bash(git reset --hard *)",
      "Edit(apps/api/alembic/versions/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/guard_irreversible.py\"",
            "timeout": 15,
            "statusMessage": "Comprobando acciones irreversibles..."
          }
        ]
      }
    ]
  }
}
